<Window x:Class="GTAVI.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GTAVI Windows Readiness"
        Width="1040" Height="760" MinWidth="780" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackground}"
        Foreground="{StaticResource PrimaryText}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,22">
            <StackPanel>
                <TextBlock Text="SYSTEM READINESS" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource AccentBrush}" />
                <TextBlock Text="Windows diagnostics" FontSize="32" FontWeight="Bold"
                           Margin="0,6,0,4"/>
                <TextBlock Text="A local snapshot of your PC's hardware and Windows configuration."
                           FontSize="14" Foreground="{StaticResource SecondaryText}"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="{StaticResource PanelBackground}"
                CornerRadius="14" Padding="18" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Hardware overview" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock x:Name="StatusText" Text="Ready to scan this PC"
                               Foreground="{StaticResource SecondaryText}" Margin="0,5,0,0"/>
                </StackPanel>
                <Button x:Name="ScanButton" Grid.Column="1" Content="Scan system"
                        Click="ScanButton_Click" Padding="18,11" Margin="12,0"
                        Background="{StaticResource AccentBrush}" Foreground="White"
                        BorderThickness="0" FontWeight="SemiBold" Cursor="Hand"/>
                <Button x:Name="ExportButton" Grid.Column="2" Content="Export report"
                        Click="ExportButton_Click" Padding="18,11"
                        Background="#30394A" Foreground="White"
                        BorderThickness="0" Cursor="Hand" IsEnabled="False"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="{StaticResource PanelBackground}"
                CornerRadius="14" Padding="20">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="DETECTED COMPONENTS"
                           FontSize="11" FontWeight="Bold" Foreground="{StaticResource SecondaryText}"
                           Margin="0,0,0,14"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="DiagnosticsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#30394A" BorderThickness="0,0,0,1"
                                        Padding="0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="190"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                   Foreground="{StaticResource SecondaryText}"
                                                   VerticalAlignment="Top"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Value}" FontSize="14"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Detail}" FontSize="11"
                                                       Foreground="{StaticResource SecondaryText}"
                                                       TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <TextBlock Grid.Row="3" Text="Independent community utility • No game files are accessed • No data is uploaded"
                   Foreground="{StaticResource SecondaryText}" FontSize="11"
                   Margin="2,14,0,0"/>
    </Grid>
</Window>
