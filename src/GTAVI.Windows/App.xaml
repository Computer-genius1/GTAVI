<Application x:Class="GTAVI.Windows.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="WindowBackground" Color="#10141C" />
        <SolidColorBrush x:Key="PanelBackground" Color="#191F2B" />
        <SolidColorBrush x:Key="AccentBrush" Color="#8B7CFF" />
        <SolidColorBrush x:Key="PrimaryText" Color="#F4F5FA" />
        <SolidColorBrush x:Key="SecondaryText" Color="#A7B0C2" />
    </Application.Resources>
</Application>
